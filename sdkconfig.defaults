# Ground Station v2.0 SDK Configuration

# Wi-Fi 설정
CONFIG_GS_WIFI_SSID="GroundStation_AP"
CONFIG_GS_WIFI_PASSWORD="groundstation2024"
CONFIG_GS_ESPNOW_CHANNEL=6

# MAVLink 설정
CONFIG_GS_MAVLINK_SYSTEM_ID=1
CONFIG_GS_MAVLINK_COMPONENT_ID=1
CONFIG_GS_MAVLINK_TARGET_SYSTEM=1
CONFIG_GS_MAVLINK_TARGET_COMPONENT=1

# 메모리 설정
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_USE_MALLOC=y

# ESP32S3 전용 기능
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# USB Serial/JTAG
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Wi-Fi 설정
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_ESPNOW_ENABLED=y

# FreeRTOS 설정
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=1

# 로그 설정
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# 컴포넌트 설정
CONFIG_MAVLINK_ENABLED=y
CONFIG_LED_STRIP_ENABLED=y

# OTA 설정
CONFIG_ESP_HTTPS_OTA=y
CONFIG_ESP_HTTP_CLIENT=y